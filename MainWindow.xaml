<Window x:Class="FileUploader.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件上传器" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Command="{Binding SelectFileCommand}" 
                    Content="选择文件夹" 
                    Padding="10,5"/>
            <Button Command="{Binding SelectSingleFileCommand}" 
                    Content="选择文件" 
                    Padding="10,5"/>
            <Button Command="{Binding UploadCommand}" 
                    Content="开始上传" 
                    Margin="10,0,0,0" 
                    Padding="10,5"/>
        </StackPanel>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Files}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件名" Binding="{Binding originFileName}" Width="*"/>
                <DataGridTextColumn Header="大小" Binding="{Binding size}" Width="100"/>
                <DataGridTextColumn Header="MD5" Binding="{Binding md5}" Width="220"/>
                <DataGridTemplateColumn Header="进度" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Value="{Binding Progress}" 
                                       Height="20" 
                                       Maximum="100"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>